# The web app and JSON API (bin/cards): HTTPS with its own certificate, progress in DuckDB.
[Unit]
Description=Google LeetCode cards
After=network-online.target google-judge.service
Wants=network-online.target google-judge.service

[Service]
User=cards
Group=cards
EnvironmentFile=/etc/google-cards.env
Environment=DATA_DIR=/opt/google-cards/current/data STATE_DIR=/var/lib/google-cards
Environment=HTTP_PORT=80 HTTPS_PORT=443 JUDGE_SOCKET=/run/google-judge/judge.sock
ExecStart=/opt/google-cards/current/bin/cards
Restart=always
RestartSec=2
StateDirectory=google-cards
StateDirectoryMode=0700
MemoryMax=200M

# Ports 80 and 443 without root, and nothing else.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
