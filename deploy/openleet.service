# The web app and JSON API (bin/openleet): HTTPS with its own certificate, progress in DuckDB.
# It heals itself: systemd restarts it when it exits or stops pinging the watchdog (it pings
# only while its database answers), and on start it migrates the database, or quarantines an
# unusable one and restores the newest daily backup (STATE_DIR/backups).
[Unit]
Description=OpenLeet
After=network-online.target openleet-judge.service
Wants=network-online.target openleet-judge.service
Requires=openleet.socket
# Never give up restarting (the default stops after 5 starts in 10 s).
StartLimitIntervalSec=0

[Service]
User=openleet
Group=openleet
EnvironmentFile=/etc/openleet.env
Environment=DATA_DIR=/opt/openleet/current/data STATE_DIR=/var/lib/openleet
Environment=JUDGE_SOCKET=/run/openleet-judge/judge.sock
ExecStart=/opt/openleet/current/bin/openleet
# READY=1 once migrated and listening; WATCHDOG=1 every 15 s while healthy.
Type=notify
NotifyAccess=main
WatchdogSec=30
Restart=always
RestartSec=1
TimeoutStopSec=10
StateDirectory=openleet
StateDirectoryMode=0700
MemoryMax=200M

# The sockets come from openleet.socket, so the server needs no privileges at all.
CapabilityBoundingSet=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
