# Python
.venv/
__pycache__/
*.py[cod]
.ruff_cache/

# JS (web/ has its own .gitignore for its build output)
node_modules/
*.tsbuildinfo
*.log

# Rust, and the release archive CI packs
target/
dist/

# Secrets
.env
.env.*
!.env.example
credentials.json
token.json
client_secret*.json

# OS / editors
.DS_Store
.idea/
.vscode/
*.swp

# Claude Code local settings
.claude/settings.local.json

# Fetched sources and local server state: DuckDB, the HTTPS certificate cache, backups and
# quarantine (STATE_DIR=data), and any other local database
data/.cache/
data/*.db
data/*.db-*
data/*.duckdb
data/*.duckdb.wal
data/acme/
data/backups/
data/quarantine/
# A release asset ("corpus"), named in data/judge/corpus.json: uv run openleet judge fetch
data/judge/tests.duckdb
