"""Design a Todo List: TodoList calls."""


def _shape(ops, args, ctor, ctor_arity, sig):
    assert isinstance(ops, list) and isinstance(args, list), "ops and args are lists"
    assert len(ops) == len(args) >= 1, "ops and args have the same length"
    assert ops[0] == ctor, "first operation is the constructor"
    assert all(isinstance(a, list) for a in args), "each args[i] is a list"
    assert len(args[0]) == ctor_arity, "constructor argument count"
    for op, a in zip(ops[1:], args[1:]):
        assert op in sig, "known method name"
        assert len(a) == sig[op], "argument count of " + op


def check(ops: list[str], args: list[list]) -> None:
    _shape(
        ops,
        args,
        "TodoList",
        0,
        {"addTask": 4, "completeTask": 2, "getAllTasks": 1, "getTasksForTag": 2},
    )
    import re

    alnum = re.compile(r"[A-Za-z0-9]*")
    assert len(ops) - 1 <= 400, "at most 100 calls to each method"
    for name in ("addTask", "completeTask", "getAllTasks", "getTasksForTag"):
        assert ops[1:].count(name) <= 100, "at most 100 calls for each method"
    dues = set()
    for op, a in zip(ops[1:], args[1:]):
        assert isinstance(a[0], int) and 1 <= a[0] <= 100, "1 <= userId <= 100"
        if op == "addTask":
            _, desc, due, tags = a
            assert isinstance(desc, str) and 1 <= len(desc) <= 50, (
                "1 <= taskDescription.length <= 50"
            )
            assert isinstance(due, int) and 1 <= due <= 100, "1 <= dueDate <= 100"
            assert due not in dues, "all dueDate values are unique"
            dues.add(due)
            assert isinstance(tags, list) and len(tags) <= 100, "0 <= tags.length <= 100"
            assert all(isinstance(t, str) and 1 <= len(t) <= 20 for t in tags), (
                "1 <= tags[i].length <= 20"
            )
            assert alnum.fullmatch(desc) and all(alnum.fullmatch(t) for t in tags), (
                "strings are letters and digits"
            )
        elif op == "completeTask":
            assert isinstance(a[1], int) and 1 <= a[1] <= 100, "1 <= taskId <= 100"
        elif op == "getTasksForTag":
            assert isinstance(a[1], str) and 1 <= len(a[1]) <= 20, "1 <= tag.length <= 20"
            assert alnum.fullmatch(a[1]), "strings are letters and digits"
