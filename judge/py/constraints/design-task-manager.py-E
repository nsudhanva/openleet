"""Design Task Manager: initial [userId, taskId, priority] triples, then calls."""

import heapq


def check(ops: list[str], args: list[list]) -> None:
    assert len(ops) == len(args) >= 1, "ops and args have the same length"
    assert len(args[0]) == 1 and isinstance(args[0][0], list), "TaskManager(tasks)"
    tasks = args[0][0]
    assert 1 <= len(tasks) <= 10**5, "1 <= tasks.length <= 10^5"
    assert len(ops) - 1 + 0 <= 2 * 10**5, "at most 2 * 10^5 calls"
    live: dict[int, int] = {}
    heap: list[tuple[int, int]] = []

    def add(user, task, pri) -> None:
        assert all(isinstance(x, int) for x in (user, task, pri)), "integer arguments"
        assert 0 <= user <= 10**5, "0 <= userId <= 10^5"
        assert 0 <= task <= 10**5, "0 <= taskId <= 10^5"
        assert 0 <= pri <= 10**9, "0 <= priority <= 10^9"
        assert task not in live, "taskId does not exist in the system when added"
        live[task] = pri
        heapq.heappush(heap, (-pri, -task))

    for t in tasks:
        assert isinstance(t, list) and len(t) == 3, "tasks[i] is [userId, taskId, priority]"
        add(*t)
    for op, a in zip(ops[1:], args[1:], strict=True):
        if op == "add":
            assert len(a) == 3, "add(userId, taskId, priority)"
            add(*a)
        elif op == "edit":
            assert len(a) == 2 and all(isinstance(x, int) for x in a), "edit(taskId, newPriority)"
            assert a[0] in live, "taskId exists in the system"
            assert 0 <= a[1] <= 10**9, "0 <= newPriority <= 10^9"
            live[a[0]] = a[1]
            heapq.heappush(heap, (-a[1], -a[0]))
        elif op == "rmv":
            assert len(a) == 1 and isinstance(a[0], int), "rmv(taskId)"
            assert a[0] in live, "taskId exists in the system"
            del live[a[0]]
        elif op == "execTop":
            assert a == [], "execTop()"
            while heap and live.get(-heap[0][1]) != -heap[0][0]:
                heapq.heappop(heap)
            if heap:
                del live[-heapq.heappop(heap)[1]]
        else:
            raise AssertionError("unknown operation")
