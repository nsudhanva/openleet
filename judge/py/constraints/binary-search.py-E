"""Binary Search: a sorted list of unique integers and a target."""


def check(nums: list[int], target: int) -> None:
    assert isinstance(target, int), "target is an integer"
    assert 1 <= len(nums) <= 10**4, "1 <= nums.length <= 10^4"
    assert all(-(10**4) < v < 10**4 for v in nums), "-10^4 < nums[i] < 10^4"
    assert -(10**4) < target < 10**4, "-10^4 < target < 10^4"
    assert all(a < b for a, b in zip(nums, nums[1:])), (
        "all integers in nums are unique and sorted in ascending order"
    )
