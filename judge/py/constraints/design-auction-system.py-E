"""Design Auction System: AuctionSystem calls."""


def _shape(ops, args, ctor, ctor_arity, sig):
    assert isinstance(ops, list) and isinstance(args, list), "ops and args are lists"
    assert len(ops) == len(args) >= 1, "ops and args have the same length"
    assert ops[0] == ctor, "first operation is the constructor"
    assert all(isinstance(a, list) for a in args), "each args[i] is a list"
    assert len(args[0]) == ctor_arity, "constructor argument count"
    for op, a in zip(ops[1:], args[1:]):
        assert op in sig, "known method name"
        assert len(a) == sig[op], "argument count of " + op


def check(ops: list[str], args: list[list]) -> None:
    _shape(
        ops,
        args,
        "AuctionSystem",
        0,
        {"addBid": 3, "getHighestBidder": 1, "removeBid": 2, "updateBid": 3},
    )
    assert len(ops) - 1 <= 5 * 10**4, "at most 5 * 10^4 calls"
    bids = set()
    for op, a in zip(ops[1:], args[1:]):
        assert all(isinstance(x, int) for x in a), "integer arguments"
        if op == "getHighestBidder":
            assert 1 <= a[0] <= 5 * 10**4, "1 <= itemId <= 5 * 10^4"
            continue
        user, item = a[0], a[1]
        assert 1 <= user <= 5 * 10**4, "1 <= userId <= 5 * 10^4"
        assert 1 <= item <= 5 * 10**4, "1 <= itemId <= 5 * 10^4"
        if op in ("addBid", "updateBid"):
            assert 1 <= a[2] <= 10**9, "1 <= bidAmount, newAmount <= 10^9"
        if op == "addBid":
            bids.add((user, item))
        else:
            assert (user, item) in bids, "updateBid/removeBid refer to an existing bid"
            if op == "removeBid":
                bids.discard((user, item))
